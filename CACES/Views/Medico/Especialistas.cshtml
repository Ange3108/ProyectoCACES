@{
    ViewData["Title"] = "Especialistas";
}

<section class="container py-5">

    <div class="text-center mb-5">
        <span class="directory-eyebrow" style="color:#1AA6A6;">
            Equipo médico
        </span>

        <h1 class="directory-title" style="color:#0B2E59;">
            Nuestros Especialistas
        </h1>

        <p class="directory-intro" style="color:#6B7280;">
            Conozca el equipo médico disponible para brindarle atención profesional y personalizada.
        </p>
    </div>

    <hr class="directory-rule" style="border-color:#D7E3EC;" />

    <div id="contenedorEspecialistas">
        <div class="text-center py-5">
            <div class="spinner-border"
                 style="color:#1AA6A6;"
                 role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
        </div>
    </div>

</section>
</section>

<section class="join-medical-team">

    <div class="container">

        <div class="join-medical-card">

            <div class="row align-items-center g-4">

                <div class="col-lg-8">

                    <span class="join-badge">
                        Oportunidad Profesional
                    </span>

                    <h2>
                        ¿Quiere formar parte de nuestro equipo médico?
                    </h2>

                    <p>
                        En CACES buscamos especialistas comprometidos con la excelencia,
                        la innovación y una atención humana. Si desea formar parte de
                        nuestro equipo, nos encantaría conocer su perfil profesional.
                    </p>

                </div>

                <div class="col-lg-4 text-lg-end text-center">

                    <a asp-controller="SolicitudMedico"
                       asp-action="SolicitarIngreso"
                       class="btn btn-join-medical">

                        <i class="bi bi-person-plus-fill me-2"></i>
                        Enviar solicitud

                    </a>

                </div>

            </div>

        </div>

    </div>

</section>

@section Scripts {
    <script src="~/js/Especialistas.js"
            asp-append-version="true"></script>
}