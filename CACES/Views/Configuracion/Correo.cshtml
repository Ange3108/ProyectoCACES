@{
    ViewData["Title"] = "Configuración del sistema";
}

<div class="container py-5">
    <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
        <div class="card-header banner-header p-4">
            <h3 class="mb-1 fw-bold"><i class="bi bi-gear me-2"></i>Configuración del sistema</h3>
            <p class="mb-0 opacity-75">Parámetros clave/valor usados por el sistema (SMTP, límites, textos, etc.).</p>
        </div>

        <div class="card-body p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div class="d-flex align-items-center gap-2">
                    <label class="form-label mb-0">Categoría:</label>
                    <select id="selectCategoria" class="form-select" style="width:220px;">
                        <option value="">Todas</option>
                    </select>
                </div>
                <button type="button" class="btn btn-primary" id="btnNuevaConfiguracion">
                    <i class="bi bi-plus-lg me-1"></i>Nueva configuración
                </button>
            </div>

            <div id="contenedorConfiguraciones">
                <div class="alert alert-info text-center rounded-3 py-4">
                    <i class="bi bi-hourglass-split fs-2 d-block mb-2 text-muted"></i>
                    Cargando configuraciones...
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ===================== MODAL: Crear Configuración ===================== -->
<div class="modal fade" id="modalCrearConfiguracion" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-plus-lg me-1"></i>Nueva configuración</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">Clave</label>
                    <input type="text" class="form-control" id="nuevaClave" placeholder="Ej. Smtp.Host">
                </div>
                <div class="mb-3">
                    <label class="form-label">Valor</label>
                    <input type="text" class="form-control" id="nuevoValor">
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Tipo</label>
                        <select class="form-select" id="nuevoTipo">
                            <option value="string">Texto</option>
                            <option value="int">Número entero</option>
                            <option value="bool">Verdadero/Falso</option>
                        </select>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Categoría</label>
                        <input type="text" class="form-control" id="nuevaCategoria" placeholder="Ej. Smtp">
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Descripción (opcional)</label>
                    <textarea class="form-control" id="nuevaDescripcion" rows="2"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" id="btnGuardarConfiguracion">Guardar</button>
            </div>
        </div>
    </div>
</div>

<!-- ===================== MODAL: Editar Configuración ===================== -->
<div class="modal fade" id="modalEditarConfiguracion" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-pencil me-1"></i>Editar configuración</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="editarIdConfiguracion">
                <div class="mb-3">
                    <label class="form-label">Clave</label>
                    <input type="text" class="form-control" id="editarClave" disabled>
                </div>
                <div class="mb-3">
                    <label class="form-label">Valor</label>
                    <input type="text" class="form-control" id="editarValor">
                </div>
                <div class="mb-3">
                    <label class="form-label">Descripción (opcional)</label>
                    <textarea class="form-control" id="editarDescripcion" rows="2"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" id="btnActualizarConfiguracion">Guardar cambios</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Configuracion.js" asp-append-version="true"></script>
}
