@model dynamic
@{
    ViewData["Title"] = "Configuración";
}


<section class="container-fluid py-4">

    <!-- ============ ENCABEZADO (paleta/tipografía de Especialistas.cshtml) ============ -->
    <div class="text-center mb-5">
        <span class="directory-eyebrow" style="color:#1AA6A6;">
            Mi cuenta
        </span>

        <h1 class="directory-title" style="color:#0B2E59;">
            Configuración
        </h1>

        <p class="directory-intro" style="color:#6B7280;">
            Administra tus preferencias, notificaciones y la seguridad de tu cuenta.
        </p>
    </div>

    <hr class="directory-rule mb-4" style="border-color:#D7E3EC;" />

    <div class="row">
        <!-- Navegación lateral (tabs verticales) -->
        <div class="col-md-3">
            <div class="list-group shadow-sm" id="configTabs" role="tablist">
                <a class="list-group-item list-group-item-action active config-tab-link" data-bs-toggle="list" href="#tab-notificaciones" role="tab">
                    <i class="bi bi-bell-fill me-2"></i>Notificaciones
                </a>
                <a class="list-group-item list-group-item-action config-tab-link" data-bs-toggle="list" href="#tab-seguridad" role="tab">
                    <i class="bi bi-shield-lock-fill me-2"></i>Seguridad
                </a>
                <a class="list-group-item list-group-item-action config-tab-link" data-bs-toggle="list" href="#tab-faq" role="tab">
                    <i class="bi bi-question-circle-fill me-2"></i>Preguntas Frecuentes
                </a>
                <a class="list-group-item list-group-item-action config-tab-link" data-bs-toggle="list" href="#tab-soporte" role="tab">
                    <i class="bi bi-headset me-2"></i>Contacto y Soporte
                </a>
                <a class="list-group-item list-group-item-action text-danger" data-bs-toggle="list" href="#tab-cuenta" role="tab">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>Eliminar Cuenta
                </a>
            </div>
        </div>

        <!-- Contenido -->
        <div class="col-md-9">
            <div class="tab-content">

                <!-- ============ NOTIFICACIONES ============ -->
                <div class="tab-pane fade show active" id="tab-notificaciones" role="tabpanel">
                    <div class="card shadow-sm">
                        <div class="card-header bg-white d-flex justify-content-between align-items-center">
                            <h5 class="mb-0" style="color:#0B2E59;">
                                <i class="bi bi-bell-fill me-2" style="color:#1AA6A6;"></i>Notificaciones
                                <span id="badgeNotificaciones" class="badge rounded-pill ms-1" style="background-color:#1AA6A6;"></span>
                            </h5>
                            <button type="button" class="btn btn-sm btn-outline-secondary" id="btnMarcarTodasLeidas">
                                Marcar todas leídas
                            </button>
                        </div>
                        <div class="card-body">

                            <div id="listaNotificaciones" class="mb-4">
                                <div class="text-center py-3">
                                    <div class="spinner-border spinner-border-sm" style="color:#1AA6A6;" role="status">
                                        <span class="visually-hidden">Cargando...</span>
                                    </div>
                                </div>
                            </div>

                            <hr style="border-color:#D7E3EC;" />

                            <div class="form-check form-switch mb-3 d-flex justify-content-between align-items-center">
                                <label class="form-check-label" for="notifCorreo">
                                    <strong>Notificaciones por correo</strong>
                                    <div class="text-muted small">Recordatorios de checkpoints y alertas del seguimiento post-operatorio</div>
                                </label>
                                <input class="form-check-input" type="checkbox" role="switch" id="notifCorreo"
                                       data-clave="NotificarCorreo" checked>
                            </div>
                            <div class="form-check form-switch mb-3 d-flex justify-content-between align-items-center">
                                <label class="form-check-label" for="notifSMS">
                                    <strong>Notificaciones por SMS</strong>
                                    <div class="text-muted small">Avisos urgentes cuando se genera una alerta de staff</div>
                                </label>
                                <input class="form-check-input" type="checkbox" role="switch" id="notifSMS"
                                       data-clave="NotificarSMS">
                            </div>
                            <div class="form-check form-switch mb-3 d-flex justify-content-between align-items-center">
                                <label class="form-check-label" for="notifSistema">
                                    <strong>Notificaciones dentro del sistema</strong>
                                    <div class="text-muted small">Badge de alertas visible en el panel administrativo</div>
                                </label>
                                <input class="form-check-input" type="checkbox" role="switch" id="notifSistema"
                                       data-clave="NotificarSistema" checked>
                            </div>

                            <hr style="border-color:#D7E3EC;" />
                            <label class="form-label"><strong>Frecuencia de resumen</strong></label>
                            <select class="form-select w-auto" id="frecuenciaResumen">
                                <option value="Diario">Diario</option>
                                <option value="Semanal">Semanal</option>
                                <option value="Nunca">Nunca</option>
                            </select>
                        </div>
                    </div>
                </div>


                <!-- ============ SEGURIDAD ============ -->
                <div class="tab-pane fade" id="tab-seguridad" role="tabpanel">
                    <div class="card shadow-sm">
                        <div class="card-header bg-white">
                            <h5 class="mb-0" style="color:#0B2E59;">
                                <i class="bi bi-shield-lock-fill me-2" style="color:#1AA6A6;"></i>Seguridad
                            </h5>
                        </div>
                        <div class="card-body">
                            <form id="formCambiarPassword">
                                <div class="mb-3">
                                    <label class="form-label">Contraseña actual</label>
                                    <div class="position-relative">
                                        <input type="password"
                                               class="form-control"
                                               id="passwordActual"
                                               name="passwordActual"
                                               autocomplete="current-password"
                                               required
                                               style="padding-right:2.6rem;" />
                                        <button type="button" class="btn btn-link toggle-password position-absolute top-50 end-0 translate-middle-y me-1 p-0 px-2"
                                                id="togglePwdActual" data-target="passwordActual" aria-label="Mostrar/ocultar contraseña">
                                            <i class="bi bi-eye" id="eyeIconActual"></i>
                                        </button>
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Nueva contraseña</label>
                                    <div class="position-relative">
                                        <input type="password"
                                               class="form-control"
                                               id="passwordNueva"
                                               name="passwordNueva"
                                               autocomplete="new-password"
                                               required
                                               style="padding-right:2.6rem;" />
                                        <button type="button" class="btn btn-link toggle-password position-absolute top-50 end-0 translate-middle-y me-1 p-0 px-2"
                                                id="togglePwdNueva" data-target="passwordNueva" aria-label="Mostrar/ocultar contraseña">
                                            <i class="bi bi-eye" id="eyeIconNueva"></i>
                                        </button>
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Confirmar nueva contraseña</label>
                                    <div class="position-relative">
                                        <input type="password"
                                               class="form-control"
                                               id="passwordConfirmar"
                                               name="passwordConfirmar"
                                               autocomplete="new-password"
                                               required
                                               style="padding-right:2.6rem;" />
                                        <button type="button" class="btn btn-link toggle-password position-absolute top-50 end-0 translate-middle-y me-1 p-0 px-2"
                                                id="togglePwdConfirmar" data-target="passwordConfirmar" aria-label="Mostrar/ocultar contraseña">
                                            <i class="bi bi-eye" id="eyeIconConfirmar"></i>
                                        </button>
                                    </div>
                                </div>
                                <button type="submit" class="btn text-white" style="background-color:#1AA6A6;">
                                    <i class="bi bi-check-circle me-1"></i>Actualizar contraseña
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
                <!-- ============ FAQ ============ -->
                <div class="tab-pane fade" id="tab-faq" role="tabpanel">
                    <div class="card shadow-sm">
                        <div class="card-header bg-white">
                            <h5 class="mb-0" style="color:#0B2E59;">
                                <i class="bi bi-question-circle-fill me-2" style="color:#1AA6A6;"></i>Preguntas Frecuentes
                            </h5>
                        </div>
                        <div class="card-body">
                            <div class="accordion" id="accordionFAQ">

                                <div class="accordion-item">
                                    <h2 class="accordion-header">
                                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq1">
                                            ¿Cómo funciona el seguimiento post-operatorio?
                                        </button>
                                    </h2>
                                    <div id="faq1" class="accordion-collapse collapse" data-bs-parent="#accordionFAQ">
                                        <div class="accordion-body">
                                            El sistema registra checkpoints según el plan asignado por tu especialista y te
                                            notifica cuando se acerca una fecha de control o revisión.
                                        </div>
                                    </div>
                                </div>

                                <div class="accordion-item">
                                    <h2 class="accordion-header">
                                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq2">
                                            ¿Puedo cambiar cómo recibo las notificaciones?
                                        </button>
                                    </h2>
                                    <div id="faq2" class="accordion-collapse collapse" data-bs-parent="#accordionFAQ">
                                        <div class="accordion-body">
                                            Sí, desde la pestaña <strong>Notificaciones</strong> puedes activar o desactivar canales
                                            (correo, SMS, sistema) y elegir la frecuencia del resumen.
                                        </div>
                                    </div>
                                </div>

                                <div class="accordion-item">
                                    <h2 class="accordion-header">
                                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq3">
                                            ¿Qué pasa si elimino mi cuenta?
                                        </button>
                                    </h2>
                                    <div id="faq3" class="accordion-collapse collapse" data-bs-parent="#accordionFAQ">
                                        <div class="accordion-body">
                                            Tu cuenta y datos asociados quedarán marcados como inactivos según la política de retención
                                            del sistema. Esta acción no se puede deshacer desde la interfaz.
                                        </div>
                                    </div>
                                </div>

                                <div class="accordion-item">
                                    <h2 class="accordion-header">
                                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq4">
                                            ¿Cómo contacto a soporte técnico?
                                        </button>
                                    </h2>
                                    <div id="faq4" class="accordion-collapse collapse" data-bs-parent="#accordionFAQ">
                                        <div class="accordion-body">
                                            Ve a la pestaña <strong>Contacto y Soporte</strong> y llena el formulario, o escríbenos
                                            directamente a los medios de contacto listados ahí.
                                        </div>
                                    </div>
                                </div>
                                <div class="accordion-item">
                                    <h2 class="accordion-header">
                                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq5">
                                            ¿Cómo reservo mis citas?
                                        </button>
                                    </h2>
                                    <div id="faq5" class="accordion-collapse collapse" data-bs-parent="#accordionFAQ">
                                        <div class="accordion-body">
                                            Ve a la pestaña <strong>Calendario Paciente</strong>, luego da click al botón
                                            <strong>Listado de Citas</strong>, y por último da click al botón de <strong>
                                            Registrar
                                            cita
                                        </strong>, llena los campos y da enviar.
                                    </div>
                                </div>
                            </div>

                            <div class="accordion-item">
                                <h2 class="accordion-header">
                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq6">
                                        ¿Cómo cambio mi contraseña?
                                    </button>
                                </h2>
                                <div id="faq6" class="accordion-collapse collapse" data-bs-parent="#accordionFAQ">
                                    <div class="accordion-body">
                                        Ve a la pestaña <strong>Seguridad</strong>, ingresa tu contraseña actual y la nueva
                                        contraseña con su confirmación, y da click en <strong>Actualizar contraseña</strong>.
                                    </div>
                                </div>
                            </div>

                            <div class="accordion-item">
                                <h2 class="accordion-header">
                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq7">
                                        ¿Cómo encuentro un especialista?
                                    </button>
                                </h2>
                                <div id="faq7" class="accordion-collapse collapse" data-bs-parent="#accordionFAQ">
                                    <div class="accordion-body">
                                        Desde el directorio de <strong>Especialistas</strong> puedes buscar por nombre,
                                        especialidad o disponibilidad, y ver el perfil de cada uno antes de agendar una cita.
                                    </div>
                                </div>
                            </div>

                            <div class="accordion-item">
                                <h2 class="accordion-header">
                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq8">
                                        ¿Qué significa la frecuencia de resumen en Notificaciones?
                                    </button>
                                </h2>
                                <div id="faq8" class="accordion-collapse collapse" data-bs-parent="#accordionFAQ">
                                    <div class="accordion-body">
                                        Define cada cuánto recibes un correo con el resumen de tu actividad y alertas
                                        pendientes: puedes elegir <strong>Diario</strong>, <strong>Semanal</strong> o
                                        <strong>Nunca</strong>, desde la pestaña Notificaciones.
                                    </div>
                                </div>
                            </div>

                            <div class="accordion-item">
                                <h2 class="accordion-header">
                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq9">
                                        Olvidé mi contraseña actual, ¿qué hago?
                                    </button>
                                </h2>
                                <div id="faq9" class="accordion-collapse collapse" data-bs-parent="#accordionFAQ">
                                    <div class="accordion-body">
                                        Si no recuerdas tu contraseña actual, no podrás cambiarla desde esta pestaña.
                                        Contáctanos desde <strong>Contacto y Soporte</strong> para que te ayudemos a
                                        recuperar el acceso a tu cuenta.
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>

                <!-- ============ CONTACTO Y SOPORTE ============ -->
                <div class="tab-pane fade" id="tab-soporte" role="tabpanel">
                    <div class="card shadow-sm">
                        <div class="card-header bg-white">
                            <h5 class="mb-0" style="color:#0B2E59;">
                                <i class="bi bi-headset me-2" style="color:#1AA6A6;"></i>Contacto y Soporte
                            </h5>
                        </div>
                        <div class="card-body">
                            <div class="row mb-4">
                                <div class="col-md-4">
                                    <i class="bi bi-envelope-fill me-1" style="color:#1AA6A6;"></i> soporte@caces.com
                                </div>
                                <div class="col-md-4">
                                    <i class="bi bi-telephone-fill me-1" style="color:#1AA6A6;"></i> +506 0000-0000
                                </div>
                                <div class="col-md-4">
                                    <i class="bi bi-clock-fill me-1" style="color:#1AA6A6;"></i> Lun - Vie, 8am - 5pm
                                </div>
                            </div>
                           
                                <a asp-area="" asp-controller="Soporte" asp-action="Contacto" class="text-decoration-none fw-bold" style="color:#27418C;">
                    ¿Desea generar una consulta? De Click Aquí
                </a>
                           
                        </div>
                    </div>
                </div>

                <!-- ============ ELIMINAR CUENTA ============ -->
                <div class="tab-pane fade" id="tab-cuenta" role="tabpanel">
                    <div class="card border-danger shadow-sm">
                        <div class="card-header bg-danger text-white">
                            <h5 class="mb-0"><i class="bi bi-exclamation-triangle-fill me-2"></i>Zona de Peligro</h5>
                        </div>
                        <div class="card-body">
                            <p><strong>Eliminar tu cuenta es una acción permanente.</strong></p>
                            <p class="text-muted">
                                Se desactivará tu acceso al sistema y tus datos personales dejarán de ser visibles
                                según la política de retención vigente. Esta acción no se puede deshacer.
                            </p>
                            <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#modalEliminarCuenta">
                                <i class="bi bi-trash-fill me-1"></i>Eliminar mi cuenta
                            </button>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</section>

<!-- Modal confirmación eliminar cuenta -->
<div class="modal fade" id="modalEliminarCuenta" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title"><i class="bi bi-exclamation-triangle-fill me-2"></i>Confirmar eliminación</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Escribe <strong>ELIMINAR</strong> para confirmar que deseas eliminar tu cuenta de forma permanente.</p>
                <input type="text" class="form-control" id="confirmarEliminarInput" placeholder="ELIMINAR" />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-danger" id="btnConfirmarEliminarCuenta" disabled>
                    <i class="bi bi-trash-fill me-1"></i>Eliminar definitivamente
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    /* Acentos tomados de Especialistas.cshtml aplicados a los tabs de Configuración */
    #configTabs .config-tab-link.active {
        background-color: #1AA6A6;
        border-color: #1AA6A6;
        color: #fff;
    }

    #configTabs .config-tab-link:not(.active):hover {
        color: #0B2E59;
    }
</style>

@section Scripts {
    
    <script src="~/js/configuracionUsuario.js" asp-append-version="true"></script>
    <script>
        configuracionUsuario.idUsuarioActual = '@User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value';
    </script>
}
