@model CACES.BLL.DTOs.Cita.RegistrarCitaDTO

@{
    ViewData["Title"] = "Agendar Procedimiento";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5">
    <div class="card shadow-lg border-0 rounded-4 overflow-hidden">

        <div class="card-header banner-header p-4">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                <div>
                    <h3 class="mb-1 fw-bold">
                        <i class="bi bi-journal-medical me-2"></i>Agendar Procedimiento Médico
                    </h3>
                    <p class="mb-0 opacity-75">
                        Complete la información requerida para programar un procedimiento médico.
                    </p>
                </div>
            </div>
        </div>

        <div class="card-body p-4">
            <form id="formAgendarProcedimiento">
                <div class="row g-4">

                    <!-- Especialidad -->
                    <div class="col-md-6">
                        <label for="IdEspecialidad" class="form-label fw-semibold">Especialidad</label>
                        <select id="IdEspecialidad" name="IdEspecialidad" class="form-select" required>
                            <option value="">Seleccione una especialidad...</option>
                        </select>
                    </div>

                    <!-- Procedimiento Médico -->
                    <div class="col-md-6">
                        <label for="IdProcedimiento" class="form-label fw-semibold">Procedimiento Médico</label>
                        <select id="IdProcedimiento" name="IdProcedimiento" class="form-select" required>
                            <option value="">Seleccione una especialidad primero</option>
                        </select>
                    </div>

                    <!-- Médico / Especialista -->
                    <div class="col-md-6">
                        <label for="IdMedico" class="form-label fw-semibold">Médico / Especialista</label>
                        <select id="IdMedico" name="IdMedico" class="form-select" required>
                            <option value="">Seleccione un procedimiento primero</option>
                        </select>
                    </div>

                    <!-- Horario -->
                    <div class="col-md-6">
                        <label for="IdHorario" class="form-label fw-semibold">Horario Disponible</label>
                        <select id="IdHorario" name="IdHorario" class="form-select" required>
                            <option value="">Seleccione un médico primero</option>
                        </select>
                    </div>

                    <!-- Fecha -->
                    <div class="col-md-3">
                        <label for="FechaCita" class="form-label fw-semibold">Fecha del Procedimiento</label>
                        <input type="date" id="FechaCita" name="FechaCita" class="form-control" required />
                    </div>

                    <!-- Hora -->
                    <div class="col-md-3">
                        <label for="Hora" class="form-label fw-semibold">Hora de Inicio</label>
                        <input type="time" id="Hora" name="Hora" class="form-control" readonly required />
                    </div>

                    <!-- Motivo / Observaciones -->
                    <div class="col-12">
                        <label for="Motivo" class="form-label fw-semibold">Motivo / Observaciones</label>
                        <textarea id="Motivo"
                                  name="Motivo"
                                  class="form-control"
                                  rows="4"
                                  maxlength="100"
                                  placeholder="Ingrese el motivo o alguna observación (máximo 100 caracteres)"></textarea>
                        <div class="d-flex justify-content-between align-items-center form-text">
                            <span>Máximo 100 caracteres.</span>
                            <span id="contadorCaracteres">0 / 100</span>
                        </div>
                    </div>

                </div>

                <hr class="my-4" />

                <!-- Botones de Acción -->
                <div class="d-flex justify-content-end gap-2 flex-wrap">
                    <a asp-controller="ProcedimientoAgendar" asp-action="MisProcedimientos" class="btn btn-secondary">
                        <i class="bi bi-arrow-left me-1"></i>Volver
                    </a>
                    <button type="submit" id="btnGuardar" class="btn btn-primary">
                        <i class="bi bi-check-circle me-1"></i>Confirmar y Agendar
                    </button>
                </div>
            </form>
        </div>

    </div>
</div>

@section Scripts {
    <script src="~/js/procedimientos.js" asp-append-version="true"></script>
}