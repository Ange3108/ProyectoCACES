@{
    ViewData["Title"] = "Mis Procedimientos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5">

    <div class="card shadow-lg border-0 rounded-4 overflow-hidden">

        <div class="card-header banner-header p-4">

            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">

                <div>
                    <h3 class="mb-1 fw-bold">
                        <i class="bi bi-journal-check me-2"></i>
                        Mis Procedimientos
                    </h3>

                    <p class="mb-0 opacity-75">
                        Consulte y administre sus procedimientos médicos agendados.
                    </p>
                </div>

                <a asp-controller="ProcedimientoAgendar"
                   asp-action="AgendarProcedimiento"
                   class="btn btn-light fw-semibold">

                    <i class="bi bi-plus-circle me-1"></i>
                    Nuevo Procedimiento

                </a>

            </div>

        </div>

        <div class="card-body p-4">

            <div id="sinMisProcedimientos"
                 class="alert alert-info text-center rounded-3 py-4 d-none">

                <i class="bi bi-calendar-x fs-2 d-block mb-2 text-muted"></i>
                No tiene procedimientos médicos agendados.

            </div>

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0"
                       id="tbMisProcedimientos"
                       style="width:100%;">

                    <thead class="table-light">

                        <tr>
                            <th>#</th>
                            <th>Procedimiento</th>
                            <th>Especialidad</th>
                            <th>Médico</th>
                            <th>Fecha</th>
                            <th>Hora</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>

                    </thead>

                    <tbody></tbody>

                </table>

            </div>

        </div>

    </div>
</div>

<!-- Modal para Ver Detalle / Ticket del Procedimiento -->
<div class="modal fade" id="modalDetalleProcedimiento" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-4 overflow-hidden">
            <div class="modal-header banner-header p-3 text-white">
                <h5 class="modal-title fw-bold">
                    <i class="bi bi-ticket-detailed me-2"></i>Detalle del Procedimiento
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4" id="contenidoTicket">
                <!-- Se llena dinámicamente desde procedimientos.js -->
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary fw-semibold" data-bs-dismiss="modal">Cerrar</button>
                <button type="button" class="btn btn-outline-primary fw-semibold" onclick="window.print()">
                    <i class="bi bi-printer me-1"></i> Imprimir
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/procedimientos.js" asp-append-version="true"></script>
}