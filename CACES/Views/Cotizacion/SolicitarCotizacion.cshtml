@model CACES.BLL.DTOs.Cotizacion.RegistrarCotizacionDTO

@{
    ViewData["Title"] = "Calcular Cotización";
}

<div class="container py-5">

    <div class="card shadow-lg border-0 rounded-4 overflow-hidden">

        <div class="card-header border-0 p-4"
             style="background:#163B73;">

            <div class="d-flex flex-column flex-md-row
                justify-content-between
                align-items-md-center gap-3">

                <div>

                    <h3 class="fw-bold text-white mb-1">

                        <i class="bi bi-calculator-fill me-2"></i>
                        Calcular Cotización

                    </h3>

                    <p class="text-white-50 mb-0">

                        Seleccione el procedimiento. El médico se asignará
                        automáticamente según la configuración del sistema.

                    </p>

                </div>

                <span class="badge rounded-pill px-3 py-2"
                      style="background:rgba(255,255,255,.14);
                    color:#ffffff;">

                    <i class="bi bi-lightning-charge-fill me-1"></i>
                    Cálculo automático

                </span>

            </div>

        </div>

        <div class="card-body p-4 p-lg-5">

            <div class="alert border-0 rounded-3 mb-4"
                 style="background:#EFF6FF;color:#1E3A8A;">

                <div class="d-flex align-items-start gap-2">

                    <i class="bi bi-info-circle-fill mt-1"></i>

                    <div>

                        <strong>Precio estimado</strong>

                        <div class="small mt-1">

                            El cálculo incluirá el precio base del procedimiento,
                            honorarios médicos, equipo, estadía e impuestos.

                        </div>

                    </div>

                </div>

            </div>

            <form id="formCotizacion">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger">
                </div>

                <div class="row g-4">

                    <div class="col-md-6">

                        <label asp-for="IdProcedimiento"
                               class="form-label fw-semibold">

                            Procedimiento

                        </label>

                        <select asp-for="IdProcedimiento"
                                id="idProcedimiento"
                                class="form-select"
                                required>

                            <option value="">
                                Seleccione un procedimiento
                            </option>

                        </select>

                        <span asp-validation-for="IdProcedimiento"
                              class="text-danger small">
                        </span>

                    </div>

                    <div class="col-md-6">

                        <label asp-for="IdMedico"
                               class="form-label fw-semibold">

                            Médico asignado

                        </label>

                        <select asp-for="IdMedico"
                                id="idMedico"
                                class="form-select"
                                readonly
                                disabled>

                            <option value="">
                                Seleccione primero un procedimiento
                            </option>

                        </select>

                        <small class="text-muted">
                            El médico será seleccionado automáticamente.
                        </small>

                        <span asp-validation-for="IdMedico"
                              class="text-danger small">
                        </span>

                    </div>

                    <div class="col-md-6">

                        <label asp-for="DiasEstadia"
                               class="form-label fw-semibold">

                            Días estimados de estadía

                        </label>

                        <div class="input-group">

                            <span class="input-group-text bg-white">

                                <i class="bi bi-calendar3"></i>

                            </span>

                            <input asp-for="DiasEstadia"
                                   id="DiasEstadia"
                                   type="number"
                                   min="1"
                                   max="30"
                                   class="form-control"
                                   required />

                            <span class="input-group-text bg-white">
                                días
                            </span>

                        </div>

                        <div class="form-text">

                            Indique entre 1 y 30 días.

                        </div>

                        <span asp-validation-for="DiasEstadia"
                              class="text-danger small">
                        </span>

                    </div>

                    <div class="col-12">

                        <div class="d-flex
                            justify-content-between
                            align-items-center">

                            <label asp-for="Observaciones"
                                   class="form-label fw-semibold">

                                Observaciones

                            </label>

                            <small class="text-muted">

                                <span id="contadorObservacionesSolicitud">
                                    0
                                </span>/500

                            </small>

                        </div>

                        <textarea asp-for="Observaciones"
                                  id="ObservacionesSolicitud"
                                  rows="5"
                                  maxlength="500"
                                  class="form-control"
                                  placeholder="Escriba aquí alergias, condiciones especiales u otros detalles relevantes..."></textarea>

                        <span asp-validation-for="Observaciones"
                              class="text-danger small">
                        </span>

                    </div>

                </div>

                <hr class="my-4" />

                <div class="d-flex flex-column flex-sm-row
                    justify-content-end gap-2">

                    <a asp-controller="Cotizacion"
                       asp-action="MisCotizaciones"
                       class="btn btn-outline-secondary rounded-3 px-4">

                        <i class="bi bi-arrow-left me-1"></i>
                        Volver

                    </a>

                    <button type="submit"
                            class="btn rounded-3 px-4 text-white fw-semibold"
                            style="background:#20C4D8;
                        border-color:#20C4D8;">

                        <i class="bi bi-calculator me-2"></i>
                        Calcular Cotización

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

<style>

    .form-control,
    .form-select,
    .input-group-text {
        min-height: 44px;
        border-color: #D4DEE8;
    }

    .form-control,
    .form-select {
        border-radius: 8px;
    }

        .form-control:focus,
        .form-select:focus {
            border-color: #20C4D8;
            box-shadow: 0 0 0 .2rem rgba(32, 196, 216, .15);
        }

    textarea.form-control {
        min-height: 130px;
    }

</style>

@section Scripts {

    <partial name="~/Views/Shared/_ValidationScriptsPartial.cshtml" />

    <script src="~/js/Cotizaciones.js"
            asp-append-version="true">
    </script>

}