@{
    ViewData["Title"] = "Mis Cotizaciones";
}

<div class="container py-5">

    <div class="card shadow-lg border-0 rounded-4 overflow-hidden">

        <div class="card-header border-0 p-4"
             style="background:#163B73;">

            <div class="d-flex flex-column flex-md-row
                justify-content-between
                align-items-md-center gap-3">

                <div>

                    <h3 class="mb-1 fw-bold text-white">

                        <i class="bi bi-file-earmark-medical-fill me-2"></i>
                        Mis Cotizaciones

                    </h3>

                    <p class="mb-0 text-white-50">

                        Consulte sus cotizaciones médicas y el desglose
                        de los costos estimados.

                    </p>

                </div>

                <a asp-controller="Cotizacion"
                   asp-action="SolicitarCotizacion"
                   class="btn text-white px-4 py-2 rounded-3 fw-semibold"
                   style="background:#20C4D8;
                    border-color:#20C4D8;">

                    <i class="bi bi-calculator me-2"></i>
                    Calcular Cotización

                </a>

            </div>

        </div>

        <div class="card-body p-4">

            <div id="alertaMisCotizaciones"
                 class="alert alert-danger border-0 rounded-3 shadow-sm d-none">

                <i class="bi bi-exclamation-triangle-fill me-2"></i>

                <span id="textoAlertaMisCotizaciones">

                    No fue posible cargar sus cotizaciones.

                </span>

            </div>

            <div id="sinMisCotizaciones"
                 class="alert alert-info border-0 rounded-3
                shadow-sm text-center py-4 d-none">

                <i class="bi bi-file-earmark-x fs-2 d-block mb-2"></i>

                <h5 class="fw-bold">
                    Todavía no tiene cotizaciones
                </h5>

                <p class="mb-3">
                    Genere una cotización para conocer el precio estimado
                    de un procedimiento.
                </p>

                <a asp-controller="Cotizacion"
                   asp-action="SolicitarCotizacion"
                   class="btn text-white rounded-3 px-4"
                   style="background:#20C4D8;">

                    <i class="bi bi-calculator me-2"></i>
                    Calcular Cotización

                </a>

            </div>

            <div id="contenedorMisCotizaciones"
                 class="table-responsive border rounded-4
                shadow-sm overflow-hidden">

                <table id="tbMisCotizaciones"
                       class="table table-hover align-middle mb-0">

                    <thead>

                        <tr>

                            <th>Fecha</th>

                            <th>Procedimiento</th>

                            <th>Médico</th>

                            <th class="text-end">
                                Total
                            </th>

                            <th class="text-center">
                                Estado
                            </th>

                            <th class="text-center"
                                style="min-width:140px;">

                                Acciones

                            </th>

                        </tr>

                    </thead>

                    <tbody>
                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>

<style>

    #tbMisCotizaciones thead th {
        padding: 14px 12px;
        color: #111827;
        background: #ffffff;
        border-bottom: 1px solid #DEE2E6;
        font-size: .9rem;
        font-weight: 600;
        white-space: nowrap;
    }

    #tbMisCotizaciones tbody td {
        padding: 14px 12px;
        vertical-align: middle;
        border-bottom: 1px solid #E5E7EB;
    }

    #tbMisCotizaciones tbody tr:last-child td {
        border-bottom: none;
    }

    #tbMisCotizaciones tbody tr:hover {
        background: #F8FAFC;
    }

    #tbMisCotizaciones .badge {
        font-weight: 500;
    }

</style>

@section Scripts {

    <script src="~/js/Cotizaciones.js"
            asp-append-version="true">
    </script>

}