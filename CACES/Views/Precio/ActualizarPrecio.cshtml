@model CACES.BLL.DTOs.Precio.MostrarPrecioDTO

@{
    ViewData["Title"] = "Actualizar Precio";
}

<main class="container py-5">

    <section class="form-shell">

        <div class="top-action mb-3">
            <a class="btn btn-add"
               asp-controller="Precio"
               asp-action="GestionPrecios">
                <i class="bi bi-arrow-left me-2"></i>
                Volver al listado
            </a>
        </div>

        <div class="card form-card shadow-sm border-0 rounded-4">

            <div class="card-body p-4 p-md-5">

                <h1 class="section-title mb-2">
                    Actualizar Precio
                </h1>

                <p class="text-muted mb-4">
                    Modifique el costo y los detalles del precio asignado al procedimiento.
                </p>

                <!-- Precio actual -->
                <div class="alert border-0 shadow-sm mb-4"
                     style="background:#eef9fc;">

                    <div class="d-flex align-items-center">

                        <i class="bi bi-cash-stack fs-2 me-3"
                           style="color:#20C4D8;"></i>

                        <div>

                            <small class="text-muted">
                                Precio actual
                            </small>

                            <h3 class="fw-bold mb-0"
                                style="color:#163B73;">

                                @Model.Costo.ToString("C")

                            </h3>

                        </div>

                    </div>

                </div>

                <form id="formActualizarPrecio">

                    <input type="hidden"
                           id="IdPrecio"
                           value="@Model.IdPrecio" />

                    <div class="row g-3">

                        <div class="col-12 col-md-6">

                            <label class="form-label">
                                Médico
                            </label>

                            <input type="text"
                                   class="form-control"
                                   value="@Model.NombreMedico"
                                   readonly />

                        </div>

                        <div class="col-12 col-md-6">

                            <label class="form-label">
                                Procedimiento
                            </label>

                            <input type="text"
                                   class="form-control"
                                   value="@Model.NombreProcedimiento"
                                   readonly />

                        </div>

                        <div class="col-12 col-md-6">

                            <label for="Costo"
                                   class="form-label">

                                Nuevo costo

                            </label>

                            <input type="number"
                                   step="0.01"
                                   class="form-control"
                                   id="Costo"
                                   value="@Model.Costo"
                                   required />

                        </div>

                        <div class="col-12">

                            <label for="Detalles"
                                   class="form-label">

                                Detalles

                            </label>

                            <textarea class="form-control"
                                      id="Detalles"
                                      rows="4"
                                      maxlength="100"
                                      placeholder="Ingrese detalles del precio..."
                                      required>@Model.Detalles</textarea>

                        </div>

                    </div>

                    <div class="d-flex flex-column flex-sm-row justify-content-end gap-2 mt-4">

                        <a asp-action="GestionPrecios"
                           class="btn btn-outline-secondary">

                            Cancelar

                        </a>

                        <button type="button"
                                class="btn btn-add"
                                onclick="actualizarPrecio()">

                            <i class="bi bi-check-lg me-2"></i>

                            Guardar cambios

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </section>

</main>

<style>

    .form-card {
        border-radius: 16px;
    }

    .section-title {
        font-size: 2rem;
        font-weight: 700;
        color: #163B73;
    }

    .form-label {
        font-weight: 600;
        color: #374151;
    }

    .form-control {
        border-radius: 10px;
        border: 1px solid #d1d5db;
        min-height: 45px;
    }

        .form-control:focus {
            border-color: #20C4D8;
            box-shadow: 0 0 0 .2rem rgba(32,196,216,.15);
        }

    textarea.form-control {
        resize: none;
        min-height: 120px;
    }

    .btn-add {
        background: #20C4D8;
        color: white;
        border: none;
        border-radius: 10px;
        padding: .65rem 1.5rem;
        font-weight: 600;
        transition: .25s;
    }

        .btn-add:hover {
            background: #17afc0;
            color: white;
        }

</style>

@section Scripts {

    <partial name="~/Views/Shared/_ValidationScriptsPartial.cshtml" />

    <script>

        function actualizarPrecio() {

            const id = $("#IdPrecio").val();

            const dto = {

                idPrecio: parseInt(id),
                costo: parseFloat($("#Costo").val()),
                detalles: $("#Detalles").val()

            };

            $.ajax({

                url: `@Url.Action("ActualizarPrecio", "Precio")?id=${id}`,
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify(dto),

                success: function(response) {

                    if (response.esCorrecto) {

                        window.location.href =
                            '@Url.Action("GestionPrecios", "Precio")';

                    } else {

                        alert(response.mensaje);

                    }

                },

                error: function(xhr) {

                    const err = xhr.responseJSON;

                    alert(err ? err.mensaje : "Error al actualizar el precio.");

                }

            });

        }

    </script>

}