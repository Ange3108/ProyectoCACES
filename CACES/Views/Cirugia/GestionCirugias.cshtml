@{
    ViewData["Title"] = "Gestión de Cirugías";
}

<div class="container py-5">
    <div class="card shadow-lg border-0 rounded-4 overflow-hidden">

        <div class="card-header banner-header p-4">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">

                <div>
                    <h3 class="mb-1 fw-bold">
                        <i class="bi bi-clipboard2-pulse me-2"></i>
                        Gestión de Cirugías
                    </h3>

                    <p class="mb-0 opacity-75">
                        Administre y consulte las cirugías programadas y su seguimiento post-operatorio.
                    </p>
                </div>

            </div>
        </div>

        <div class="card-body p-4">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0"
                       id="tbGestionCirugias"
                       style="width:100%;">

                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Paciente</th>
                            <th>Procedimiento</th>
                            <th>Médico</th>
                            <th>Fecha</th>
                            <th>Hora</th>
                            <th>Estado</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>

                    <tbody></tbody>

                </table>

            </div>

        </div>
    </div>
</div>

<!-- Modal de Seguimiento Post-Operatorio -->
<div class="modal fade"
     id="modalSeguimiento"
     tabindex="-1"
     aria-labelledby="tituloModalSeguimiento"
     aria-hidden="true">

    <div class="modal-dialog modal-lg modal-dialog-centered">

        <div class="modal-content border-0 rounded-4 shadow-lg overflow-hidden">

            <div class="modal-header border-0 px-4 py-3"
                 style="background-color: #163B73;">

                <div>
                    <h5 class="modal-title text-white fw-bold mb-1"
                        id="tituloModalSeguimiento">

                        <i class="bi bi-heart-pulse me-2"></i>
                        Seguimiento Post-Operatorio
                    </h5>

                    <p class="text-white-50 small mb-0">
                        Consulte el estado del seguimiento post-quirúrgico del paciente.
                    </p>
                </div>

                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal"
                        aria-label="Cerrar">
                </button>

            </div>

            <div class="modal-body p-4" id="contenidoSeguimiento">
                <div class="text-center text-muted py-3">Cargando...</div>
            </div>

        </div>

    </div>
</div>

@section Scripts {
    <script src="~/js/gestionCirugias.js" asp-append-version="true"></script>
}
