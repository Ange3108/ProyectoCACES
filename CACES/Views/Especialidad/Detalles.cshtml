@using CACES.BLL.DTOs.Especialidad
@model mostrarDetalleEspecialidadDTO

<section class="container py-5">

    <a asp-area="" asp-controller="Especialidad" asp-action="Especialidades" class="back-link mb-4">
        <i class="bi bi-arrow-left"></i> Volver al directorio
    </a>

    <header class="chapter-header mt-4 mb-5">
        <span class="chapter-icon">
            <i class="@Model.NombreIcono"></i>
        </span>
        <div>
            <span class="directory-eyebrow">Especialidad</span>
            <h1 class="chapter-title">@Model.Nombre</h1>
            <p class="chapter-lead">@Model.Descripcion</p>
        </div>
    </header>

    <hr class="directory-rule" />

    <section class="mb-5">
        <span class="section-eyebrow">Atención disponible</span>
        <h2 class="section-heading">Procedimientos</h2>

        @if (Model.Procedimientos != null && Model.Procedimientos.Any())
        {
            <div class="ledger">
                @foreach (var procedimiento in Model.Procedimientos)
                {
                    <div class="ledger-row d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-start gap-3">
                            <span class="ledger-mark"><i class="bi bi-plus-lg"></i></span>
                            <div>
                                <p class="ledger-name mb-1">@procedimiento.Nombre</p>
                                @if (!string.IsNullOrWhiteSpace(procedimiento.Descripcion))
                                {
                                    <p class="ledger-desc mb-0">@procedimiento.Descripcion</p>
                                }
                            </div>
                        </div>

                        <!-- PRECIO BASE -->
                        <div class="text-end ms-3">
                            <span class="badge rounded-pill px-3 py-2" style="background-color: #E6F7F7; color: #0B6F73; font-weight: 600; font-size: 0.9rem;">
                                ₡@procedimiento.PrecioBase
                            </span>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <p class="empty-note">Todavía no hay procedimientos registrados para esta especialidad.</p>
        }
    </section>

    <section>
        <span class="section-eyebrow">Equipo médico</span>
        <h2 class="section-heading">Especialistas</h2>

        @if (Model.Medicos != null && Model.Medicos.Any())
        {
            <div class="staff-grid">
                @foreach (var medico in Model.Medicos)
                {
                    var fotoRuta = ResolverFoto(medico.Foto);
                    var nombreCompleto = $"{medico.Nombres} {medico.PrimerApellido} {medico.SegundoApellido}".Trim();

                    <div class="staff-card">
                        <img src="@fotoRuta"
                             alt="Foto de @nombreCompleto"
                             class="staff-photo"
                             style="object-fit: cover;"
                             onerror="this.onerror=null; this.src='/img/default.jpg';" />

                        <p class="staff-role">Especialista</p>
                        <h3 class="staff-name">Dr(a). @nombreCompleto</h3>
                        <p class="staff-phone"><i class="bi bi-telephone"></i> @medico.Telefono</p>

                        <!-- CAMBIO AQUÍ: Se usa un button con la clase btn-ver-perfil en vez de <a> -->
                        <button type="button" class="staff-link btn-ver-perfil" data-id="@medico.IdMedico" style="background:none; border:none; padding:0; cursor:pointer;">
                            Ver perfil
                        </button>
                    </div>
                }
            </div>
        }
        else
        {
            <p class="empty-note">Todavía no hay médicos asignados a esta especialidad.</p>
        }
    </section>
</section>

<!-- MODAL PARA MOSTRAR LA PARCIAL DE DETALLE -->
<div class="modal fade" id="modalDetalleMedico" tabindex="-1" aria-labelledby="modalDetalleMedicoLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 1.25rem; overflow: hidden;">
            <div class="modal-header border-0 pb-0" style="background-color: #ffffff;">
                <h5 class="modal-title fw-bold" style="color: #0B2E59;" id="modalDetalleMedicoLabel">Perfil del Especialista</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body p-4" id="contenidoModalMedico" style="background-color: #ffffff;">
                <!-- AJAX inyectará el contenido aquí -->
            </div>
            <div class="modal-footer border-0 pt-0" style="background-color: #ffffff;">
                <button type="button" class="btn btn-sm rounded-pill px-4 text-secondary" data-bs-dismiss="modal" style="border: 1px solid #D7E3EC;">
                    Cerrar
                </button>
            </div>
        </div>
    </div>
</div>

@{
    ViewData["Title"] = Model.Nombre;

    string ResolverFoto(string? foto)
    {
        if (string.IsNullOrWhiteSpace(foto)) return "/img/default.jpg";
        foto = foto.Trim();
        if (foto.StartsWith('/') || foto.StartsWith("http", StringComparison.OrdinalIgnoreCase)) return foto;
        if (foto.StartsWith("img/", StringComparison.OrdinalIgnoreCase) || foto.StartsWith("uploads/", StringComparison.OrdinalIgnoreCase)) return $"/{foto}";
        return $"/img/{foto}";
    }
}

@section Scripts {
    <script src="~/js/Especialistas.js" asp-append-version="true"></script>
}