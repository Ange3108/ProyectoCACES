@{
    ViewData["Title"] = "Gestión de Pacientes";
}

<div class="container py-5">

    <div class="card border-0 shadow-lg rounded-4 overflow-hidden">

        <!-- ENCABEZADO -->
        <div class="card-header border-0 py-4"
             style="background:#163B73;">

            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">

                <div>

                    <h2 class="text-white fw-bold mb-1">
                        <i class="bi bi-people-fill me-2"></i>
                        Gestión de Pacientes
                    </h2>

                    <p class="text-white-50 mb-0">
                        Consulte, registre y administre los pacientes del sistema.
                    </p>

                </div>

                <a asp-controller="Paciente"
                   asp-action="RegistrarPaciente"
                   class="btn text-white px-4 py-2 rounded-3 fw-semibold shadow-sm"
                   style="background:#20C4D8;border:none;">

                    <i class="bi bi-plus-lg me-2"></i>
                    Agregar Paciente

                </a>

            </div>

        </div>

        <div class="card-body p-4">

            @if (TempData["Mensaje"] != null)
            {
                <div class="alert alert-success rounded-3 shadow-sm">
                    <i class="bi bi-check-circle-fill me-2"></i>
                    @TempData["Mensaje"]
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger rounded-3 shadow-sm">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    @TempData["Error"]
                </div>
            }

            <div class="table-responsive border rounded-4 shadow-sm overflow-hidden">

                <table id="tbPacientes" class="table table-hover align-middle mb-0 w-100">

                    <thead style="background:#163B73;color:white;">

                        <tr>

                            <th>Paciente</th>
                            <th>DUI</th>
                            <th>Correo</th>
                            <th>Teléfono</th>
                            <th>Dirección</th>
                            <th>Estado</th>
                            <th style="width:320px;" class="text-center">
                                Acciones
                            </th>

                        </tr>

                    </thead>

                    <tbody>
                        <!-- DataTables llena esto vía AJAX -->
                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <script src="~/js/Paciente.js"></script>
    <script>
        $(function () {
            Pacientes.init(@(User.IsInRole("Administrador") ? "true" : "false"));
            });
    </script>
}