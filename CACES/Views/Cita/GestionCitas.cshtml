@{
    ViewData["Title"] = "Gestión de Citas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5">
    <div class="card shadow-lg border-0 rounded-4 overflow-hidden">

        <div class="card-header banner-header p-4">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">

                <div>
                    <h3 class="mb-1 fw-bold">
                        <i class="bi bi-calendar-check me-2"></i>
                        Gestión de Citas
                    </h3>

                    <p class="mb-0 opacity-75">
                        Administre y consulte las citas médicas registradas.
                    </p>
                </div>

                @if (User.IsInRole("Paciente"))
                {
                    <a asp-controller="Cita"
                       asp-action="RegistrarCita"
                       class="btn btn-light fw-semibold">

                        <i class="bi bi-plus-circle me-1"></i>
                        Nueva Cita

                    </a>
                }

            </div>
        </div>

        <div class="card-body p-4">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0"
                       id="tbGestionCitas"
                       style="width:100%;">

                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>Fecha</th>
                            <th>Hora</th>
                            <th>Paciente</th>
                            <th>Médico</th>
                            <th>Especialidad</th>
                            <th>Procedimiento</th>
                            <th>Motivo</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>

                    <tbody></tbody>

                </table>

            </div>

        </div>
    </div>
</div>

<div class="modal fade"
     id="modalEditarCita"
     tabindex="-1"
     aria-labelledby="tituloModalEditarCita"
     aria-hidden="true">

    <div class="modal-dialog modal-lg modal-dialog-centered">

        <div class="modal-content border-0 rounded-4 shadow-lg overflow-hidden">

            <div class="modal-header border-0 px-4 py-3"
                 style="background-color: #163B73;">

                <div>
                    <h5 class="modal-title text-white fw-bold mb-1"
                        id="tituloModalEditarCita">

                        <i class="bi bi-pencil-square me-2"></i>
                        Editar cita médica
                    </h5>

                    <p class="text-white-50 small mb-0">
                        Actualice la información de la cita seleccionada.
                    </p>
                </div>

                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal"
                        aria-label="Cerrar">
                </button>

            </div>

            <div class="modal-body p-4">

                <input type="hidden" id="editarIdCita" />

                <div class="row g-4">

                    <div class="col-md-6">

                        <label for="editarEspecialidad"
                               class="form-label fw-semibold text-dark">

                            <i class="bi bi-heart-pulse me-1 text-info"></i>
                            Especialidad
                        </label>

                        <select id="editarEspecialidad"
                                class="form-select rounded-3">
                        </select>

                    </div>

                    <div class="col-md-6">

                        <label for="editarMedico"
                               class="form-label fw-semibold text-dark">

                            <i class="bi bi-person-badge me-1 text-info"></i>
                            Médico
                        </label>

                        <select id="editarMedico"
                                class="form-select rounded-3">
                        </select>

                    </div>

                    <div class="col-md-6">

                        <label for="editarHorario"
                               class="form-label fw-semibold text-dark">

                            <i class="bi bi-clock me-1 text-info"></i>
                            Horario
                        </label>

                        <select id="editarHorario"
                                class="form-select rounded-3">
                        </select>

                    </div>

                    <div class="col-md-6">

                        <label for="editarFecha"
                               class="form-label fw-semibold text-dark">

                            <i class="bi bi-calendar-event me-1 text-info"></i>
                            Fecha
                        </label>

                        <input type="date"
                               id="editarFecha"
                               class="form-control rounded-3" />

                    </div>

                    <div class="col-12">

                        <label for="editarMotivo"
                               class="form-label fw-semibold text-dark">

                            <i class="bi bi-file-earmark-medical me-1 text-info"></i>
                            Motivo de la cita
                        </label>

                        <textarea id="editarMotivo"
                                  class="form-control rounded-3"
                                  rows="4"
                                  maxlength="100"
                                  placeholder="Ingrese el motivo de la cita">
                        </textarea>

                        <div class="form-text">
                            Máximo 100 caracteres.
                        </div>

                    </div>

                </div>

            </div>

            <div class="modal-footer border-0 bg-light px-4 py-3">

                <button type="button"
                        class="btn btn-outline-secondary rounded-3 px-4"
                        data-bs-dismiss="modal">

                    <i class="bi bi-x-circle me-1"></i>
                    Cancelar
                </button>

                <button type="button"
                        class="btn rounded-3 px-4 text-white fw-semibold"
                        style="background-color: #17B26A;"
                        onclick="Citas.guardarEdicion()">

                    <i class="bi bi-check-circle me-1"></i>
                    Guardar cambios
                </button>

            </div>

        </div>

    </div>
</div>

@section Scripts {
    <script src="~/js/citas.js" asp-append-version="true"></script>
}