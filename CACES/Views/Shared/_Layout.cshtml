<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CACES</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.datatables.net/v/bs5/dt-2.3.8/datatables.min.css" rel="stylesheet" integrity="sha384-UclYA0TM50oo4lzbw9CylacalWmOxu+RipNT22BDrqDD9v2F0M+262NAs03TOfhw" crossorigin="anonymous">
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11.26.25/dist/sweetalert2.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg custom-navbar">
            <div class="container-fluid px-3 px-lg-4">
                <a class="navbar-brand brand-block" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="brand-icon"><img src="~/img/logoCACES.jpg" alt="Logo"></span>
                    <span class="brand-name">CACES</span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                        aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav mx-auto nav-center-list">
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Inicio</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Especialidad" asp-action="Especialidades">Especialidades</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Paquete" asp-action="ObtenerPaquetesSoloActivos">Turismo Médico</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Medico" asp-action="Especialistas">Especialistas</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Convenio" asp-action="ObtenerConveniosSoloActivos">Convenios</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Conocenos">Conózcanos</a></li>

                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            @* Menú Paciente *@
                            @if (User.IsInRole("Paciente"))
                            {
                                <li class="nav-item dropdown"><a class="nav-link dropdown-toggle" href="#" id="dropdownPaciente" role="button" data-bs-toggle="dropdown" aria-expanded="false"><i class="bi bi-person-heart me-1"></i>Paciente</a><ul class="dropdown-menu" aria-labelledby="dropdownPaciente"><li><a class="dropdown-item" asp-controller="Cita" asp-action="Calendario"><i class="bi bi-calendar3 me-2"></i>Calendario Paciente</a></li><li><a class="dropdown-item" asp-controller="Procedimientos" asp-action="ObtenerProcedimientos"><i class="bi bi-clipboard2-pulse me-2"></i>Procedimientos Quirúrgicos</a></li></ul></li>
                            }

                            @* Menú Médico *@
                            @if (User.IsInRole("Medico"))
                            {
                                <li class="nav-item dropdown"><a class="nav-link dropdown-toggle" href="#" id="dropdownMedico" role="button" data-bs-toggle="dropdown" aria-expanded="false"><i class="bi bi-heart-pulse me-1"></i>Médico</a><ul class="dropdown-menu" aria-labelledby="dropdownMedico"><li><a class="dropdown-item" asp-controller="Cita" asp-action="Calendario"><i class="bi bi-calendar3 me-2"></i>Calendario Médico</a></li><li><a class="dropdown-item" asp-controller="Paciente" asp-action="Pacientes"><i class="bi bi-folder2-open me-2"></i>Historiales de Pacientes</a></li></ul></li>
                            }

                            @* Menú Administrador *@
                            @if (User.IsInRole("Administrador"))
                            {
                                <li class="nav-item dropdown"><a class="nav-link dropdown-toggle" href="#" id="dropdownAdministrador" role="button" data-bs-toggle="dropdown" aria-expanded="false"><i class="bi bi-gear-fill me-1"></i>Administración</a><ul class="dropdown-menu" aria-labelledby="dropdownAdministrador"><li><a class="dropdown-item" asp-controller="Home" asp-action="Reportes"><i class="bi bi-bar-chart-line me-2"></i>Reportes</a></li></ul></li>
                            }

                            @* Opciones comunes *@
                            <li class="nav-item dropdown"><a class="nav-link dropdown-toggle" href="#" id="dropdownCuenta" role="button" data-bs-toggle="dropdown" aria-expanded="false"><i class="bi bi-person-circle me-1"></i>Mi cuenta</a><ul class="dropdown-menu dropdown-menu-end" aria-labelledby="dropdownCuenta"><li><a class="dropdown-item" asp-controller="Home" asp-action="configuracionUsuario"><i class="bi bi-sliders me-2"></i>Configuración</a></li><li><hr class="dropdown-divider"></li><li><form asp-controller="Login_Logout" asp-action="Logout" method="post">@Html.AntiForgeryToken()<button type="submit" class="dropdown-item text-danger"><i class="bi bi-box-arrow-right me-2"></i>Cerrar sesión</button></form></li></ul></li>
                        }
                    </ul>
                </div>

                <div class="dropdown ms-2" id="campanitaNotificaciones">
                    <button class="btn btn-link text-decoration-none position-relative" type="button"
                            id="btnCampanita" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi bi-bell fs-5"></i>
                        <span id="badgeCampanita"
                              class="badge rounded-pill bg-danger position-absolute top-0 start-100 translate-middle d-none">
                            0
                        </span>
                    </button>
                    <div class="dropdown-menu dropdown-menu-end p-0 shadow" style="width:340px;" aria-labelledby="btnCampanita">
                        <div class="d-flex justify-content-between align-items-center px-3 py-2 border-bottom">
                            <strong>Notificaciones</strong>
                            <button type="button" class="btn btn-sm btn-link text-decoration-none p-0" id="btnMarcarTodasLeidas">
                                Marcar todas como leídas
                            </button>
                        </div>
                        <div id="listaCampanita" style="max-height:360px; overflow-y:auto;">
                            <div class="text-center text-muted py-4">Cargando...</div>
                        </div>
                    </div>
                </div>

                @* Icono de cuenta *@
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <a class="account-link" asp-area="" asp-controller="Perfil" asp-action="VerPerfil" aria-label="Cuenta">
                        <i class="bi bi-person"></i>
                    </a>
                }
                else
                {
                    <a class="account-link" asp-area="" asp-controller="Login_Logout" asp-action="Login" aria-label="Iniciar sesión">
                        <i class="bi bi-person"></i>
                    </a>
                }
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="mt-5 py-4" style="background:#72CEF2;">
        <div class="container text-center">
            <p class="mb-1 fw-semibold" style="color:#27418C;">Centro Ambulatorio de Cirugía Escalón</p>
            <p class="mb-3">
                <a asp-area="" asp-controller="Soporte" asp-action="Contacto" class="text-decoration-none fw-bold" style="color:#27418C;">
                    Contacto y soporte
                </a>
            </p>

            <div class="row justify-content-center g-2 mb-3" style="color:#27418C;">
                <div class="col-6 col-md-3">
                    <i class="bi bi-telephone-fill me-1"></i>
                    <a href="tel:+50325031980" class="text-decoration-none" style="color:#27418C;">+503 2503 1980</a>
                </div>
                <div class="col-6 col-md-3">
                    <i class="bi bi-envelope-fill me-1"></i>
                    <a href="mailto:cirugiacacesmoon@gmail.com" class="text-decoration-none" style="color:#27418C;">cirugiacacesmoon@gmail.com</a>
                </div>
                <div class="col-6 col-md-3">
                    <i class="bi bi-geo-alt-fill me-1"></i>
                    <a href="https://maps.app.goo.gl/dLXaJqiDBP1pWboH9" target="_blank" rel="noopener noreferrer" class="text-decoration-none" style="color:#27418C;">
                        Calle Circunvalación #175, San Salvador
                    </a>
                </div>
                <div class="col-6 col-md-3">
                    <i class="bi bi-clock-fill me-1"></i>
                    Siempre abierto
                </div>
            </div>

            <div class="d-flex justify-content-center gap-3">
                <a href="https://www.facebook.com/caces.sv/" target="_blank" rel="noopener noreferrer" aria-label="Facebook" style="color:#27418C; font-size:1.25rem;">
                    <i class="bi bi-facebook"></i>
                </a>
                <a href="https://www.instagram.com/caceshosp" target="_blank" rel="noopener noreferrer" aria-label="Instagram" style="color:#27418C; font-size:1.25rem;">
                    <i class="bi bi-instagram"></i>
                </a>
                <a href="https://wa.me/50379126456" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp" style="color:#27418C; font-size:1.25rem;">
                    <i class="bi bi-whatsapp"></i>
                </a>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.datatables.net/v/bs5/dt-2.3.8/datatables.min.js" integrity="sha384-M6UGhVy7VWBGzDEGllTBBFgXu43d6sWM07qFvlFrfOr/R3GhL8TLsG0iwMzJuX3N" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.26.25/dist/sweetalert2.all.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/Campanita.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
