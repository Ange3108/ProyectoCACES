@{
    ViewData["Title"] = "Gestión de Convenios";
}

<div class="container py-5">
    <div class="card border-0 shadow-lg rounded-4 overflow-hidden">

        <div class="card-header border-0 py-4" style="background:#163B73;">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                <div>
                    <h2 class="text-white fw-bold mb-1">
                        <i class="bi bi-handbag-fill me-2"></i>
                        Gestión de Convenios
                    </h2>
                    <p class="text-white-50 mb-0">
                        Administra los convenios y descuentos activos en el sistema.
                    </p>
                </div>

                <div>
                    <a asp-controller="Convenio" asp-action="CrearConvenio" class="btn text-white px-4 py-2 rounded-3 fw-semibold shadow-sm" style="background:#20C4D8; border:none;">
                        <i class="bi bi-plus-lg me-2"></i>Nuevo Convenio
                    </a>
                </div>
            </div>
        </div>

        <div class="card-body p-4">

            <div class="table-responsive border rounded-4 shadow-sm overflow-hidden">
                <table class="table table-hover align-middle mb-0" id="tablaConvenios">
                    <thead style="background:#163B73; color:white;">
                        <tr>
                            <th class="ps-4">Nombre</th>
                            <th>Descripción</th>
                            <th>Descuento</th>
                            <th>Teléfono Contacto</th>
                            <th>Estado</th>
                            <th style="width:200px;" class="text-center pe-4">Acciones</th>
                        </tr>
                    </thead>
                    <tbody id="tbodyConvenios">
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <div class="spinner-border text-primary me-2" role="status"></div>
                                Cargando convenios...
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Convenio.js" asp-append-version="true"></script>
}