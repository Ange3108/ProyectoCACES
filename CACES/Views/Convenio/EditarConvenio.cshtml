@{
    ViewData["Title"] = "Editar Convenio";
    int idConvenio = ViewBag.IdConvenio;
}

<div class="container-fluid px-4 mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white py-3">
                    <h4 class="fw-bold mb-0">Editar Convenio</h4>
                </div>
                <div class="card-body p-4">
                    <input type="hidden" id="txtIdConvenio" value="@idConvenio" />

                    <form id="formEditarConvenio" onsubmit="guardarEdicionConvenio(event)">
                        <div class="mb-3">
                            <label for="txtNombre" class="form-label fw-semibold">Nombre *</label>
                            <input type="text" class="form-control" id="txtNombre" required />
                        </div>

                        <div class="mb-3">
                            <label for="txtDescripcion" class="form-label fw-semibold">Descripción</label>
                            <textarea class="form-control" id="txtDescripcion" rows="3"></textarea>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="txtDescuentoPorcentaje" class="form-label fw-semibold">Descuento (%) *</label>
                                <input type="number" step="0.01" min="0" max="100" class="form-control" id="txtDescuentoPorcentaje" required />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="txtTelefono" class="form-label fw-semibold">Teléfono de Contacto</label>
                                <input type="text" class="form-control" id="txtTelefono" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="txtImagenUrl" class="form-label fw-semibold">URL de Imagen</label>
                            <input type="text" class="form-control" id="txtImagenUrl" />
                        </div>

                        <div class="form-check form-switch mb-4">
                            <input class="form-check-input" type="checkbox" id="chkEstado" />
                            <label class="form-check-label fw-semibold" for="chkEstado">Estado Activo</label>
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                            <button type="submit" class="btn btn-warning" id="btnGuardar">
                                <i class="bi bi-pencil me-1"></i> Actualizar Convenio
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/convenio-editar.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
}
