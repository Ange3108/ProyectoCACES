@{
    ViewData["Title"] = "Nuevo Convenio";
}

<div class="container-fluid px-4 mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white py-3">
                    <h4 class="fw-bold mb-0">Registrar Nuevo Convenio</h4>
                </div>
                <div class="card-body p-4">
                    <form id="formCrearConvenio" onsubmit="guardarNuevoConvenio(event)">
                        <div class="mb-3">
                            <label for="txtNombre" class="form-label fw-semibold">Nombre *</label>
                            <input type="text" class="form-control" id="txtNombre" required placeholder="Ej. Convenio Hospital Metropolitano" />
                        </div>

                        <div class="mb-3">
                            <label for="txtDescripcion" class="form-label fw-semibold">Descripción</label>
                            <textarea class="form-control" id="txtDescripcion" rows="3" placeholder="Detalles del convenio..."></textarea>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="txtDescuentoPorcentaje" class="form-label fw-semibold">Descuento (%) *</label>
                                <input type="number" step="0.01" min="0" max="100" class="form-control" id="txtDescuentoPorcentaje" required placeholder="0.00" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="txtTelefono" class="form-label fw-semibold">Teléfono de Contacto</label>
                                <input type="text" class="form-control" id="txtTelefono" placeholder="Ej. 8888-8888" />
                            </div>
                        </div>

                        <div class="mb-4">
                            <label for="txtImagenUrl" class="form-label fw-semibold">URL de Imagen</label>
                            <input type="text" class="form-control" id="txtImagenUrl" placeholder="https://..." />
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                            <button type="submit" class="btn btn-primary" id="btnGuardar">
                                <i class="bi bi-save me-1"></i> Guardar Convenio
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/convenio-crear.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
}