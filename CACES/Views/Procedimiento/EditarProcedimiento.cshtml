@using CACES.BLL.DTOs.Procedimientos
@model InsertarProcedimientosDto

@{
    ViewData["Title"] = "Editar Procedimiento";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">

            <!-- Enlace de regreso -->
            <a asp-action="ObtenerProcedimientosQuirur" class="text-decoration-none mb-4 d-inline-block fw-semibold" style="color: #163B73;">
                <i class="bi bi-arrow-left me-1"></i> Volver al listado
            </a>

            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">

                <!-- Encabezado corporativo -->
                <div class="card-header border-0 py-4" style="background:#163B73;">
                    <h2 class="text-white fw-bold mb-1">
                        <i class="bi bi-pencil-square me-2"></i>
                        Editar Procedimiento
                    </h2>
                    <p class="text-white-50 mb-0">
                        Modifique la información general, especialidad asignada o costo base de la intervención.
                    </p>
                </div>

                <div class="card-body p-5">
                    <!-- Formulario procesado por JS -->
                    <form id="formEditarProcedimiento" onsubmit="guardarEdicionProcedimiento(event)">
                        @Html.AntiForgeryToken()

                        <!-- ID Oculto necesario para el JS -->
                        <input type="hidden" id="txtIdProcedimiento" value="@(ViewBag.IdProcedimiento ?? ViewContext.RouteData.Values["id"])" />

                        <div class="mb-3">
                            <label for="txtNombre" class="form-label">Nombre del Procedimiento</label>
                            <input type="text" id="txtNombre" class="form-control" required />
                        </div>

                        <div class="mb-3">
                            <label for="txtDescripcion" class="form-label">Descripción</label>
                            <textarea id="txtDescripcion" class="form-control" rows="3"></textarea>
                        </div>

                        <div class="mb-3">
                            <label for="selectEspecialidad" class="form-label">Especialidad</label>
                            <select id="selectEspecialidad" class="form-select" required>
                                <option value="">Cargando especialidades...</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label for="txtPrecioBase" class="form-label">Precio Base</label>
                            <input type="number" step="0.01" id="txtPrecioBase" class="form-control" required />
                        </div>

                        <div class="form-check mb-3">
                            <input class="form-check-input" type="checkbox" id="chkEstado" />
                            <label class="form-check-label" for="chkEstado">Activo</label>
                        </div>

                        <button type="submit" id="btnGuardar" class="btn btn-primary">
                            <i class="bi bi-pencil me-1"></i> Actualizar Procedimiento
                        </button>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/procedimientos-editar.js"></script>
}