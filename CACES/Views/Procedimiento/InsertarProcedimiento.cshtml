@using CACES.BLL.DTOs.Procedimientos
@model InsertarProcedimientosDto

@{
    ViewData["Title"] = "Nuevo Procedimiento";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">

            <!-- Enlace de regreso al listado global -->
            <a asp-action="ObtenerProcedimientosQuirur" class="text-decoration-none mb-4 d-inline-block fw-semibold" style="color: #163B73;">
                <i class="bi bi-arrow-left me-1"></i> Volver al listado
            </a>

            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">

                <!-- Encabezado corporativo -->
                <div class="card-header border-0 py-4" style="background:#163B73;">
                    <h2 class="text-white fw-bold mb-1">
                        <i class="bi bi-plus-circle me-2"></i>
                        Registrar Nuevo Procedimiento
                    </h2>
                    <p class="text-white-50 mb-0">
                        Complete el formulario para incorporar una nueva intervención quirúrgica o médica al sistema.
                    </p>
                </div>

                <div class="card-body p-5">
                    <!-- Formulario procesado por JS -->
                    <form id="formCrearProcedimiento" onsubmit="guardarNuevoProcedimiento(event)">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label for="txtNombre" class="form-label">Nombre del Procedimiento</label>
                            <input type="text" id="txtNombre" class="form-control" required />
                        </div>

                        <div class="mb-3">
                            <label for="txtDescripcion" class="form-label">Descripción</label>
                            <textarea id="txtDescripcion" class="form-control" rows="3"></textarea>
                        </div>

                        <div class="mb-3">
                            <label for="selectEspecialidad" class="form-label">Especialidad</label>
                            <select id="selectEspecialidad" class="form-select" required>
                                <option value="">-- Seleccione una especialidad --</option>
                                @if (ViewBag.Especialidades != null)
                                {
                                    foreach (var item in ViewBag.Especialidades)
                                    {
                                        <option value="@item.IdEspecialidad">@item.Nombre</option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="mb-3">
                            <label for="txtPrecioBase" class="form-label">Precio Base</label>
                            <input type="number" step="0.01" id="txtPrecioBase" class="form-control" required />
                        </div>

                        <button type="submit" id="btnGuardar" class="btn btn-primary">
                            <i class="bi bi-save me-1"></i> Guardar Procedimiento
                        </button>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/procedimientos-crear.js"></script>
}